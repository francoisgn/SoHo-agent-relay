# Copier en .env (gitignore) et adapter. Jamais de secret ici : jetons -> trousseau.
# Alias SSH (~/.ssh/config) ou user@host du serveur Docker
HA_HOST=my-nas
# Dossier de deploiement sur le serveur (compose + config/)
HA_REMOTE_DIR=/path/to/homeassistant
# Commandes docker sur le serveur (ex. Synology : sudo /usr/local/bin/docker-compose)
HA_COMPOSE="docker-compose"
HA_DOCKER="docker"
# Fuseau horaire et plafond memoire du conteneur
TZ=Europe/Paris
HA_MEM_LIMIT=1g
