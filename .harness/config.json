{
  "language": "en",
  "exclude": [
    ".harness/docs/ORCHESTRATION.md",
    ".harness/docs/FINOPS.md",
    ".harness/docs/STEWARDS.md",
    ".harness/docs/COMPLIANCE.md",
    ".harness/docs/REVIEW-SERVICE.md",
    ".harness/docs/README-STANDARD.md",
    ".harness/docs/USAGE.md",
    ".harness/docs/POSITIONING.md",
    ".harness/docs/lessons-inventory.md",
    ".harness/docs/adr/*",
    ".harness/docs/ai-layers/*",
    ".harness/docs/factory/*",
    ".harness/docs/diagrams/*",
    ".harness/docs/assets/*",
    ".harness/scripts/flow-metrics.py",
    ".harness/scripts/merge-gate.py",
    ".harness/scripts/compliance-plan.py",
    ".harness/scripts/readme-check.py",
    ".harness/scripts/readme-progress.py",
    ".harness/scripts/issue-reconcile.py",
    ".harness/scripts/diagrams-render.py",
    ".harness/scripts/doc-links.py",
    ".harness/scripts/doc-steward.py",
    ".harness/scripts/decisions-check.py",
    ".harness/scripts/job-timeout.py",
    ".harness/scripts/orch-state.py",
    ".harness/templates/*",
    ".harness/hooks/pre-commit-secrets.sh",
    ".claude/skills/lot-start/*",
    ".claude/skills/lot-finish/*",
    ".claude/skills/feedback-triage/*",
    ".claude/skills/readme-update/*",
    ".claude/skills/status-report/*",
    ".claude/skills/compliance-review/*",
    ".claude/agents/compliance-*",
    ".claude/agents/doc-steward.md",
    ".claude/agents/issue-steward.md",
    ".claude/agents/flow-monitor.md",
    ".github/ISSUE_TEMPLATE/feedback.yml",
    ".github/workflows/harness*",
    "docs/lots/*",
    "docs/compliance/*",
    "docs/DECISIONS.md",
    "docs/diagrams/*",
    ".coderabbit.yaml",
    "scripts/local-check.sh"
  ],
  "orchestration": {
    "memory_issue": null
  },
  "protected_branches": [
    "main"
  ],
  "integration_branch": "main",
  "branch_model": "B",
  "branch_types": [
    "lot",
    "fix",
    "feat",
    "chore",
    "docs",
    "bootstrap"
  ],
  "default_branch_check": false,
  "labels": {
    "model_prefixes": [
      "difficulty:"
    ],
    "size_prefixes": []
  },
  "ledger": {
    "enabled": false,
    "label": "ledger",
    "fold_command": ""
  },
  "coderabbit": {
    "agent_requests_review": false
  },
  "merge_gate": {
    "required_labels": [],
    "security_labels": [
      "type: security"
    ],
    "body_lines": [
      "issue",
      "docs"
    ]
  },
  "compliance": [],
  "readme": {
    "badges": true,
    "image": false,
    "architecture": "ascii",
    "progress": false,
    "quickstart": true,
    "contributing": true
  }
}
