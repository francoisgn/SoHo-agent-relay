{
  "$comment": "Repository settings, applied on merge by the `settings` job of harness.yml (secret REPO_ADMIN_TOKEN). Project file: adapt it, then change it by PR, never by hand in Settings. Add the required checks (job names) once the CI is stable: CI-BUDGET.md §4.",
  "repository": {
    "description": "Always-on Claude Code agent in a hardened container on a home server (NAS), with guardrails: policy hooks, PR-only GitHub, read-mostly network APIs.",
    "delete_branch_on_merge": true,
    "has_wiki": false,
    "has_projects": false
  },
  "topics": [
    "claude-code",
    "ai-agent",
    "docker",
    "homelab",
    "synology",
    "guardrails",
    "self-hosted"
  ],
  "rulesets": [
    {
      "name": "protected default branch",
      "target": "branch",
      "enforcement": "active",
      "conditions": {
        "ref_name": {
          "include": [
            "~DEFAULT_BRANCH"
          ],
          "exclude": []
        }
      },
      "bypass_actors": [],
      "rules": [
        {
          "type": "deletion"
        },
        {
          "type": "non_fast_forward"
        },
        {
          "type": "pull_request",
          "parameters": {
            "required_approving_review_count": 0,
            "dismiss_stale_reviews_on_push": false,
            "require_code_owner_review": false,
            "require_last_push_approval": false,
            "required_review_thread_resolution": true
          }
        }
      ]
    }
  ]
}
