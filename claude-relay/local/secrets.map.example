# Secrets du relais : copier en local/secrets.map (non versionné) et adapter, puis
# scripts/set-secret.sh --all. Une ligne par secret, jamais de valeur ici :
#   <nom> <service du trousseau> [compte|-]     (- = tout compte ; défaut : RELAY_KEYCHAIN_ACCOUNT)
#   <nom> cmd:<commande qui écrit le secret sur stdout>
# Dans le conteneur : variable <NOM> (gh_token -> GH_TOKEN, pour gh et git).
gh_token       cmd:gh auth token
unifi_api_key  claude-relay-unifi
qbt_password   my-qbittorrent-webui -
# Certificat du NAS (bin/relay-acme) : PAT Gandi limité au domaine (ou gandi_livedns_key, clé
# API legacy valable pour tout le compte), administrateur DSM dédié
gandi_livedns_token  gandi-livedns-pat
syno_acme_password   soho-acme acme-deploy
