# claude-relay : copier en .env (non versionné) et adapter. Lu par scripts/*.sh et,
# sur l'hôte, par docker-compose (copié à côté du docker-compose.yml par deploy.sh).

# Alias SSH de l'hôte Docker (défini dans ~/.ssh/config, jamais d'IP ici)
RELAY_SSH_HOST=my-server
# Dossier racine sur l'hôte : app/ (fichiers déployés), home/, workspace/, logs/, secrets/
RELAY_DATA=/srv/claude-relay
# Binaires sur l'hôte (Synology : /usr/local/bin/docker et docker-compose via sudo)
RELAY_DOCKER="sudo docker"
RELAY_COMPOSE="sudo docker-compose"

# uid/gid de l'utilisateur du conteneur, propriétaire des volumes (pas d'utilisateur hôte)
RELAY_UID=1500
RELAY_GID=1500
# Nom de la session dans l'app Claude et hostname du conteneur
RELAY_NAME=claude-relay
# remote-control (défaut) | channels
RELAY_MODE=remote-control
RELAY_CHANNELS=plugin:telegram@claude-plugins-official
# true pour Channels (plugins Bun)
RELAY_INSTALL_BUN=false
RELAY_MEM_LIMIT=1g
TZ=Europe/Paris

# Trousseau macOS : service du jeton `claude setup-token` (lu par set-token.sh)
RELAY_KEYCHAIN_SERVICE=claude-relay-oauth
RELAY_KEYCHAIN_ACCOUNT=claude-relay
# compose v1 : délai API Docker (hôte lent : 60 s par défaut ne suffit pas toujours)
COMPOSE_HTTP_TIMEOUT=600

# Accès SSH du relais à son hôte (scripts/grant-host-ssh.sh). Adresse de l'hôte vue depuis
# le conteneur : IP LAN stable de l'hôte (vide = passerelle du réseau Docker, qui change si
# le réseau est recréé). Utilisateur hôte (vide = celui de RELAY_SSH_HOST).
RELAY_HOST_ADDR=
RELAY_HOST_USER=
# Réseaux d'où la clé du relais est acceptée (option from= de authorized_keys)
RELAY_HOST_FROM=172.16.0.0/12

# Intégrations. Secrets : jamais ici, trousseau du Mac -> scripts/set-secret.sh -> secrets/<nom>.
# UniFi Network, API d'intégration locale : adresse de la console vue depuis le conteneur
# (https://<IP LAN>). Clé : scripts/set-secret.sh unifi_api_key <service du trousseau>.
# Doc pour agents : https://developer.ui.com/network/v11.0.97/ai-gettingstarted.md
UNIFI_URL=
# Certificat auto-signé de la console : true = curl -k (LAN uniquement)
UNIFI_INSECURE=true
# GitHub : jeton fine-grained -> scripts/set-secret.sh gh_token <service du trousseau>.
# Identité des commits du relais (adresse noreply GitHub de préférence)
RELAY_GIT_NAME=
RELAY_GIT_EMAIL=

# Certificat Let's Encrypt du NAS (bin/relay-acme : DNS-01 Gandi LiveDNS, déployé dans DSM).
# Secrets : scripts/set-secret.sh gandi_livedns_token <service> (PAT Gandi limité au domaine)
# et syno_acme_password <service> (administrateur DSM dédié, applications refusées, sans 2FA).
RELAY_ACME_DOMAIN=
RELAY_ACME_SYNO_USER=
RELAY_ACME_SYNO_PORT=5001
# letsencrypt_test pour un essai (certificat non reconnu, quotas larges)
RELAY_ACME_SERVER=letsencrypt
# <nom>:<IP LAN du NAS>, pour joindre DSM par son nom depuis le conteneur
RELAY_ACME_HOSTS_ENTRY=
