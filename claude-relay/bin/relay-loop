#!/usr/bin/env bash
# Boucle de supervision, lancée dans tmux : démarre Claude Code selon RELAY_MODE et le
# relance s'il s'arrête (ex. Remote Control en mode serveur sort après ~10 min sans réseau ;
# `claude remote-control` relancé dans le même dossier reprend les sessions < ~4 h).
#
# RELAY_MODE=remote-control (défaut) : `claude remote-control` (mode serveur, app Claude).
#   Exige un login claude.ai complet (`claude auth login`) : le jeton `setup-token`
#   (CLAUDE_CODE_OAUTH_TOKEN) ne peut PAS ouvrir de session Remote Control.
# RELAY_MODE=channels : session interactive `claude --channels $RELAY_CHANNELS`
#   (+ --remote-control si login complet, sinon jeton setup-token monté en secret).
set -uo pipefail

STATE=/tmp/relay-state
TOKEN_FILE=/run/relay-secrets/oauth_token
CREDS="$HOME/.claude/.credentials.json"
RELAY_MODE=${RELAY_MODE:-remote-control}
RELAY_NAME=${RELAY_NAME:-claude-relay}
RELAY_CHANNELS=${RELAY_CHANNELS:-plugin:telegram@claude-plugins-official}

# Message horodaté : dans le terminal tmux et dans `docker logs` (stdout du PID 1).
log() {
  local m
  m="[relay $(date -u +%FT%TZ)] $*"
  printf '%s\n' "$m"
  printf '%s\n' "$m" >/proc/1/fd/1 2>/dev/null || true
}
state() { printf '%s\n' "$1" >"$STATE"; }

echo $$ >/tmp/relay-loop.pid
cd /workspace || exit 1

# GitHub : jeton fine-grained (scripts/set-secret.sh gh_token …) exporté pour gh ; git emprunte
# gh comme credential helper (rien d'écrit en clair). Identité des commits : RELAY_GIT_NAME/EMAIL.
GH_TOKEN_FILE=/run/relay-secrets/gh_token
if [ -r "$GH_TOKEN_FILE" ] && [ -s "$GH_TOKEN_FILE" ]; then
  GH_TOKEN="$(tr -d '\r\n' <"$GH_TOKEN_FILE")"
  export GH_TOKEN
  if command -v gh >/dev/null 2>&1; then
    if ! { git config --global credential.https://github.com.helper '' &&
      git config --global --add credential.https://github.com.helper '!gh auth git-credential'; }; then
      log "warning: could not set the git credential helper for github.com"
    fi
  else
    log "warning: gh_token present but gh is not installed in the image"
  fi
fi
# Autres secrets (scripts/set-secret.sh) : chaque fichier de /run/relay-secrets devient une
# variable d'environnement en majuscules (qbt_password -> QBT_PASSWORD). Leurs noms, non secrets,
# vont dans RELAY_SECRET_NAMES : le hook guard-bash refuse de les afficher.
RELAY_SECRET_NAMES=""
for f in /run/relay-secrets/*; do
  [ -f "$f" ] && [ -r "$f" ] && [ -s "$f" ] || continue
  n=${f##*/}
  case "$n" in oauth_token | gh_token | *.new) continue ;; esac
  [[ $n =~ ^[a-z][a-z0-9_]*$ ]] || continue
  v=${n^^}
  # Jamais une variable déjà définie (PATH, HOME, RELAY_*…) : un fichier mal nommé ne la remplace pas.
  if [ -n "${!v+x}" ]; then
    log "warning: secret $n ignored, \$$v is already set"
    continue
  fi
  printf -v "$v" '%s' "$(tr -d '\r\n' <"$f")"
  export "${v?}"
  RELAY_SECRET_NAMES="$RELAY_SECRET_NAMES $v"
done
export RELAY_SECRET_NAMES
[ -z "$RELAY_SECRET_NAMES" ] || log "secrets in the environment:$RELAY_SECRET_NAMES"
[ -z "${RELAY_GIT_NAME:-}" ] || git config --global user.name "$RELAY_GIT_NAME"
[ -z "${RELAY_GIT_EMAIL:-}" ] || git config --global user.email "$RELAY_GIT_EMAIL"

backoff=10
while true; do
  unset CLAUDE_CODE_OAUTH_TOKEN
  cmd=()
  case "$RELAY_MODE" in
    remote-control)
      if [ ! -s "$CREDS" ]; then
        state waiting-login
        log "no claude.ai login yet: run 'docker exec -it claude-relay claude auth login' (retry in 60s)"
        sleep 60
        continue
      fi
      cmd=(claude remote-control --name "$RELAY_NAME" --spawn same-dir --permission-mode auto)
      ;;
    channels)
      read -r -a channels <<<"$RELAY_CHANNELS"
      cmd=(claude)
      # Reprendre la dernière conversation du workspace si elle existe.
      if compgen -G "$HOME/.claude/projects/-workspace/*.jsonl" >/dev/null; then
        cmd+=(--continue)
      fi
      cmd+=(--channels "${channels[@]}")
      if [ -s "$CREDS" ]; then
        # Login complet : on ajoute Remote Control ; surtout pas le jeton (il primerait).
        cmd+=(--remote-control "$RELAY_NAME")
      elif [ -r "$TOKEN_FILE" ] && [ -s "$TOKEN_FILE" ]; then
        CLAUDE_CODE_OAUTH_TOKEN="$(tr -d '\r\n' <"$TOKEN_FILE")"
        export CLAUDE_CODE_OAUTH_TOKEN
      else
        state waiting-login
        log "no credentials: run 'claude auth login' in the container or scripts/set-token.sh (retry in 60s)"
        sleep 60
        continue
      fi
      ;;
    *)
      state error
      log "unknown RELAY_MODE='$RELAY_MODE' (expected remote-control|channels)"
      sleep 300
      continue
      ;;
  esac

  state running
  log "starting: ${cmd[*]}"
  start=$(date +%s)
  "${cmd[@]}"
  rc=$?
  unset CLAUDE_CODE_OAUTH_TOKEN
  elapsed=$(( $(date +%s) - start ))

  # Sortie rapide = probable erreur de config : on espace les relances (max 5 min).
  if [ "$elapsed" -lt 60 ]; then
    backoff=$(( backoff * 2 > 300 ? 300 : backoff * 2 ))
  else
    backoff=10
  fi
  state restarting
  log "claude exited (rc=$rc after ${elapsed}s), restarting in ${backoff}s"
  sleep "$backoff"
done
